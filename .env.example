# ==============================================================================
# VARIABLES DE ENTORNO - PLATAFORMA INMOBILIARIA COMERCIAL
# ==============================================================================
# Copia este archivo como .env.local para desarrollo local
# y configura estas mismas variables en Vercel (Settings > Environment Variables)
# ==============================================================================

# 1. BOT DE TELEGRAM PARA ALERTAS DEL ASESOR
# Generado con @BotFather en Telegram
TELEGRAM_BOT_TOKEN="tu-bot-token-aqui"

# Chat ID privado del asesor (obtenlo enviando cualquier mensaje a @userinfobot)
TELEGRAM_ADVISOR_CHAT_ID="tu-chat-id-aqui"

# 2. BASE DE DATOS DEFINITIVA (SUPABASE POSTGRESQL)
# URL del proyecto en Supabase (Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL="https://tu-proyecto.supabase.co"

# Service Role Secret Key (Settings > API > Project API keys > service_role)
# Permite lectura y escritura segura en el servidor de Next.js sin restricciones RLS
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-secret-key-aqui"

# Clave pública anónima (opcional, como respaldo si no se usa service_role)
NEXT_PUBLIC_SUPABASE_ANON_KEY="tu-anon-key-aqui"

# 3. CREDENCIALES DE ADMINISTRADOR (RESPALDO LOCAL)
# Se usan cuando Supabase Auth no está configurado o disponible
ADMIN_EMAIL="tu-correo-admin@ejemplo.com"
ADMIN_PASSWORD="tu-contraseña-segura-aqui"

# 4. SEGURIDAD DE SESIONES (OPCIONAL)
# Clave secreta de 32+ caracteres para firmar cookies de sesión con HMAC-SHA256
# Si no se define, se deriva automáticamente del SUPABASE_SERVICE_ROLE_KEY
HMAC_SESSION_SECRET=""

# 5. TAREA DIARIA (VERCEL CRON)
# Protege /api/cron/daily (vencimiento de atribuciones + resumen diario por Telegram).
# Vercel la envía automáticamente como "Authorization: Bearer <CRON_SECRET>".
# Genera un valor aleatorio de 32+ caracteres. Sin ella, la tarea queda deshabilitada.
CRON_SECRET=""

# 6. WEBHOOK DE TELEGRAM (RECOMENDADO)
# Secreto que Telegram envía en cada llamada al webhook; el sitio lo registra al
# configurar el webhook y rechaza llamadas que no lo incluyan.
TELEGRAM_WEBHOOK_SECRET=""
